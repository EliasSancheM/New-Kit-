# ---------------------------------------------------------------------------
# IAFactory QA Kit - Configuration Template
# Copia este archivo a .env o configuralo en tu entorno
# ---------------------------------------------------------------------------

# Token de integración de Notion (ntn_...)
# Debe tener permisos de lectura y escritura en la página contenedora de QA
NOTION_TOKEN=ntn_your_notion_integration_token_here

# ID de la planilla de Google Sheets y nombre de pestaña
SPREADSHEET_ID=1Ddc43mRVFNtSCVNWwSxOi_IZZXHof_LJxel6qVqJlxM
SHEET_NAME=Ai-Factory

# ID de la página contenedora de Notion ("MDs pruebas")
NOTION_PARENT_PAGE_ID=3b8f79fc-5514-80e3-bbe0-cb9cd1ee14cc

# Nombre del usuario de QA responsable (si se deja vacío, se autodetecta de git config o se consulta en setup)
USER_NAME=

# ---------------------------------------------------------------------------
# Estructura de tu workspace (opcional: solo si difiere de la de IAFactory)
# ---------------------------------------------------------------------------
# Ruta absoluta al workspace. Si no se define, se autodetecta subiendo desde el
# directorio actual hasta encontrar un archivo '.qa-kit-root', una carpeta
# 'Reportes/' o alguno de los repos de QA_KIT_REPOS.
# WORKSPACE_ROOT=C:/ruta/a/tu/workspace

# Carpetas de los repos de producto, relativas a WORKSPACE_ROOT (separadas por coma)
# QA_KIT_REPOS=ai-factory-core,ai-factory-agents,ai-factory-frontend,ai-factory-platform
# Repos usados por fast_test_runner.py
# QA_KIT_FRONTEND_REPO=ai-factory-frontend
# QA_KIT_AGENTS_REPO=ai-factory-agents

# ---------------------------------------------------------------------------
# Entornos remotos (VMs): definidos en environments.json
# ---------------------------------------------------------------------------
# Entorno por defecto cuando no se pasa --env (dev, qa, team-devs...)
# QA_KIT_ENV=dev
# Usuario de pruebas para refresh_auth.py (storageState para navegador)
# QA_TEST_USER=
# QA_TEST_PASSWORD=

# ---------------------------------------------------------------------------
# Espejo local en Obsidian (opcional, desactivado por defecto)
# ---------------------------------------------------------------------------
# Con 1, report-bug/qa-finish/qa-rejection escriben docs/vault/defectos/AF-XXX.md
# en el workspace (copia local de solo escritura; nada la vuelve a leer).
# QA_KIT_OBSIDIAN=1

# ---------------------------------------------------------------------------
# TLS (solo si ves CERTIFICATE_VERIFY_FAILED detrás de un proxy/antivirus)
# ---------------------------------------------------------------------------
# Solución recomendada: genera el bundle con
#   python <KIT>/skills/qa-preflight/scripts/build_ca_bundle.py
# y pega aquí la ruta que imprime. Mantiene la verificación TLS activa y
# gcloud (API, SSH, túneles IAP) lo usa solo cuando lo lanza el kit.
# QA_KIT_CA_BUNDLE=C:/Users/<usuario>/AppData/Local/iafactory-qa-kit/ca_bundle.pem
# Necesario además con Python 3.13+ si el CA del antivirus no es "estricto".
# QA_KIT_TLS_RELAX_STRICT=1
# Desactiva la verificación TLS por completo. Último recurso.
# QA_KIT_INSECURE_TLS=1
# Túnel IAP/SSH: desactiva la verificación del certificado solo en el websocket de IAP
# (antivirus tipo Avast que intercepta wss://tunnel.cloudproxy.app)
# QA_KIT_IAP_INSECURE_WS=1
