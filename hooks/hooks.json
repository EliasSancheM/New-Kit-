{
  "description": "Recuerda cargar las reglas de operación del IAFactory QA Kit (rules/AGENTS.md) antes de hacer QA con el kit.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
